# ローカル設定ファイル
# 追跡中のファイルでローカルな変更が必要な場合は、以下を使用します:
# git update-index --skip-worktree <file>
# 例: git update-index --skip-worktree docker-coredns/config/hosts

# 環境変数ファイル
syslogng-openobserve/.env

# 一時ファイル
syslogng-openobserve/syslog-gen_*

# Pythonキャッシュ
__pycache__/
*.pyc

# OpenObserve
syslogng-openobserve/openobserve/db/
# data ディレクトリの中身をすべて無視...
syslogng-openobserve/openobserve/data/*
!syslogng-openobserve/openobserve/data/.gitkeep

# Fluent Bit
syslogng-openobserve/fluent-bit/buffer/
!syslogng-openobserve/fluent-bit/buffer/**/.keepme

# Temporary files
syslogng-openobserve/*.csv

# CoreDNS build artifacts
docker-coredns/coredns/

# dnsmasq (検証中断のため除外)
docker-dnsmasq/
