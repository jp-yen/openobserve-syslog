# ローカル設定ファイル
# 追跡中のファイルでローカルな変更が必要な場合は、以下を使用します:
# git update-index --skip-worktree <file>
# 例: git update-index --skip-worktree docker-coredns/config/hosts

# 環境変数ファイル
syslogng-openobserve/.env

# 一時ファイル
syslogng-openobserve/syslog-gen_*

# Pythonキャッシュ
__pycache__/
*.pyc

# OpenObserve
syslogng-openobserve/openobserve/db/
# data ディレクトリの中身をすべて無視...
syslogng-openobserve/openobserve/data/*
!syslogng-openobserve/openobserve/data/.gitkeep

# AxoSyslog
syslogng-openobserve/axosyslog/buffer/
!syslogng-openobserve/axosyslog/buffer/**/.keepme
syslogng-openobserve/axosyslog/conf/syslog-ng.persist
syslogng-openobserve/axosyslog/conf/syslog-ng.pid
syslogng-openobserve/axosyslog/conf/syslog-ng.ctl
# すべてのログファイルを無視...
syslogng-openobserve/axosyslog/conf/log/*
!syslogng-openobserve/axosyslog/conf/log/.keepme
syslogng-openobserve/scratch/

# Temporary files
syslogng-openobserve/*.csv

# CoreDNS build artifacts
docker-coredns/coredns/
